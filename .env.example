# Neon PostgreSQL (use pooled connection string in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob — used for workout and nutrition photos/videos.
# Connected automatically when the gymsynk-guides Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=

# Session JWT signing secret — use letters/numbers only to avoid .env parsing issues.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=64characterhexstringhere

# Optional: separate secret for member door-entry QR codes (defaults to AUTH_SECRET)
# ACCESS_QR_SECRET=another64characterhexstringhere

# Public app URL (used for Stripe redirect URLs and embed book links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret so SmartSynk can list and create gyms. Same value as GYMSYNK_ADMIN_API_KEY on SmartSynk.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SMARTSYNK_API_KEY=

# Comma-separated origins allowed to fetch public schedule JSON (required for JS embed on external sites)
PUBLIC_SCHEDULE_CORS_ORIGINS=https://resetstudios.vercel.app,https://resetstudios.co.uk,https://www.resetstudios.co.uk

# Default gym slug for /join when no tenant query param is provided
DEFAULT_TENANT_SLUG=reset

# Password for seeded staff accounts (Reset + demo gym owner/admin/trainer)
SEED_STAFF_PASSWORD=choose-a-strong-password

# Resend — member welcome emails (https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=Reset Studios <welcome@resetstudios.co.uk>

# Stripe — platform account (GymSynk). Enable Connect in Dashboard for gym payouts.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly GymSynk platform fee (Price on the platform account, not Connect)
STRIPE_PRICE_GYMSYNK_PLATFORM=price_...
# Local dev only: allow checkout without Connect onboarding complete
# STRIPE_CONNECT_OPTIONAL=true
# Membership plan prices (on each gym's Connect account after onboarding, or platform in dev)
STRIPE_PRICE_RESET_INDIVIDUAL=price_...
STRIPE_PRICE_RESET_COUPLES=price_...
STRIPE_PRICE_RESET_FAMILY=price_...
