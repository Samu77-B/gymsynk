# Neon PostgreSQL (use pooled connection string in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Session JWT signing secret — use letters/numbers only to avoid .env parsing issues.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=64characterhexstringhere

# Public app URL (used for Stripe redirect URLs and embed book links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated origins allowed to fetch public schedule JSON (default: any origin)
# PUBLIC_SCHEDULE_CORS_ORIGINS=https://resetstudios.vercel.app,https://resetstudios.co.uk

# Default gym slug for /join when no tenant query param is provided
DEFAULT_TENANT_SLUG=reset

# Stripe — create Products/Prices in Dashboard, then paste Price IDs (price_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_RESET_INDIVIDUAL=price_...
STRIPE_PRICE_RESET_COUPLES=price_...
STRIPE_PRICE_RESET_FAMILY=price_...
